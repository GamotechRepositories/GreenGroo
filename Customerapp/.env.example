# Copy to .env (never commit .env). Release builds always use API_LIVE_URL (see lib/config/env.dart).
# Local testing: USE_LIVE_API=false and API_BASE_URL = this PC's LAN IP (phone on the same WiFi).
API_BASE_URL=http://192.168.1.49:5001
API_LIVE_URL=https://api.greengrocc.com
USE_LIVE_API=true

# Live order tracking map
#   google = Google Maps (needs MAPS_API_KEY in android/local.properties and ios/Flutter/*.xcconfig)
#   osm    = free OpenStreetMap, no key
MAP_PROVIDER=google
# false hides the map (ETA, driver card and timeline still show)
LIVE_MAP_ENABLED=true

STORE_URL=https://www.greengrocc.in
MERCHANT_UPI_ID=your-merchant@upi
MERCHANT_UPI_NAME=GreenGrocc
