# Server
PORT=5001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/greengroccdb

# Auth
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d

# MSG91 (OTP)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_ENTITY_ID=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AWS S3 / CloudFront
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
CLOUDFRONT_URL=

# Firebase (push notifications)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Envia shipping
ENVIA_API_TOKEN=
ENVIA_USE_SANDBOX=true
ENVIA_FORCE_ENABLE=false
ENVIA_DEFAULT_CARRIER=
ENVIA_DEFAULT_SERVICE=
ENVIA_RATE_CARRIERS=

# Public URLs
PUBLIC_API_URL=
BACKEND_URL=
API_BASE_URL=
