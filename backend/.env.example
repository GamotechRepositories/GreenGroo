# Server
PORT=5001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/greengroccdb

# Auth
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d
ADMIN_MOBILE=7499972072

# MSG91 (OTP)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=GREGRC
MSG91_ENTITY_ID=

# MSG91 DLT Templates (Header: GREGRC)
MSG91_TEMPLATE_DELIVERY_VERIFY=1277179206470002377
MSG91_TEMPLATE_ADMIN_LOGIN=1277179206046350946
MSG91_TEMPLATE_USER_LOGIN=1277179206610483262
MSG91_TEMPLATE_USER_REG=1277179206667336427
MSG91_TEMPLATE_DELIVERY_LOGIN=1277179206817944860
MSG91_TEMPLATE_DELIVERY_REG=1277179206647085826
MSG91_TEMPLATE_FARMER_REG=1277179206800949621
MSG91_TEMPLATE_FARMER_LOGIN=1277179206725138232
MSG91_TEMPLATE_ID=1277179206610483262

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AWS S3 / CloudFront
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
CLOUDFRONT_URL=
CLOUDFRONT_DOMAIN=cdn.greengrocc.com

# Firebase Admin — DELIVERY partner app (project: greengrocc-27df8)
# Copy values from: Firebase Console → greengrocc-27df8 → Project Settings → Service Accounts → Generate new private key
# Put private_key on ONE line with \n for newlines, inside double quotes.
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# Fallbacks (optional — leave empty if using individual vars above)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Firebase Admin — CUSTOMER app (project: userapp-1ac3c)
# Copy values from: Firebase Console → userapp-1ac3c → Project Settings → Service Accounts → Generate new private key
CUSTOMER_FIREBASE_TYPE=service_account
CUSTOMER_FIREBASE_PROJECT_ID=
CUSTOMER_FIREBASE_PRIVATE_KEY_ID=
CUSTOMER_FIREBASE_PRIVATE_KEY=
CUSTOMER_FIREBASE_CLIENT_EMAIL=
CUSTOMER_FIREBASE_CLIENT_ID=
CUSTOMER_FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
CUSTOMER_FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
CUSTOMER_FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
CUSTOMER_FIREBASE_CLIENT_X509_CERT_URL=
CUSTOMER_FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# Envia shipping
ENVIA_API_TOKEN=
ENVIA_USE_SANDBOX=true
ENVIA_FORCE_ENABLE=false
ENVIA_DEFAULT_CARRIER=
ENVIA_DEFAULT_SERVICE=
ENVIA_RATE_CARRIERS=

# Public URLs
PUBLIC_API_URL=
BACKEND_URL=
API_BASE_URL=

# Live order tracking: server-side Google Directions (route polyline + ETA). Optional;
# without it the API falls back to a distance-based ETA estimate.
GOOGLE_MAPS_API_KEY=
