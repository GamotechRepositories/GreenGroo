# Local
VITE_API_URL=http://localhost:5001

# Live farmer site is HTTPS. The API is HTTP-only (http://api.greengrocc.com).
# Do NOT point the browser at http:// — mixed content will block login.
#
# Render (pick one):
# 1) Static Site → Redirects/Rewrites, ABOVE the SPA /* rule:
#    Source: /api/*
#    Destination: http://api.greengrocc.com/api/*
#    Action: Rewrite
# 2) Web Service → Build: npm install && npm run build
#    Start: npm start
#    API_PROXY_TARGET=http://api.greengrocc.com
