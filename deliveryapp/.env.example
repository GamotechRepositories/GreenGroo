# Copy to `.env` (never commit `.env`).
# Physical phone: set API_BASE_URL to this PC's ipconfig IPv4, e.g. http://192.168.1.56:5001
# Android emulator: http://127.0.0.1:5001 (rewritten to 10.0.2.2)
# Release APK/AAB always uses API_LIVE_URL (HTTPS production).

API_BASE_URL=http://127.0.0.1:5001
API_LIVE_URL=https://api.greengrocc.com
USE_LIVE_API=false

# ── Firebase client config (from Firebase Console → Project settings) ───────
# These are client identifiers (also in google-services.json), NOT Admin secrets.
# Admin service-account private key must live only on the backend server.
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTH_DOMAIN=

FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=

FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=com.greenrow.delivery

FIREBASE_MACOS_APP_ID=
FIREBASE_MACOS_BUNDLE_ID=com.example.deliveryapp

FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=

FIREBASE_WINDOWS_APP_ID=
FIREBASE_WINDOWS_MEASUREMENT_ID=
