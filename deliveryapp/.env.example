# Copy to `.env`.
# Physical phone: set API_BASE_URL to this PC's ipconfig IPv4, e.g. http://192.168.1.56:5001
# Android emulator: http://127.0.0.1:5001 (rewritten to 10.0.2.2)
# Release APK/AAB always uses API_LIVE_URL (HTTPS production).

API_BASE_URL=http://127.0.0.1:5001
API_LIVE_URL=https://api.greengrocc.com
USE_LIVE_API=false
